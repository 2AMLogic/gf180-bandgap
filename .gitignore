*.raw
*.log
__pycache__/
.DS_Store

# Generated at smoke-test run time from $PDK_ROOT/$PDK (machine-specific
# absolute path) by sim/smoke_test/run_smoke_test.sh -- not committed;
# sim/smoke_test/smoke_test.log (force-added, see below) is the durable
# evidence of a run.
sim/smoke_test/pdk_include.spice
sim/smoke_test/*.raw

# smoke_test.log is force-added (git add -f) despite the blanket *.log
# ignore above -- it is append-only evidence per CLAUDE.md, not a scratch
# log.
!sim/smoke_test/smoke_test.log

# Raw per-corner ngspice logs under sim/<experiment>/corners/<record-id>/ are
# the evidence trail sim/README.md requires each record to link to -- they are
# committed, not scratch, so they are exempted from the blanket *.log ignore.
!sim/*/corners/**/*.log

# Simulation harness scratch: generated ngspice decks. Disposable; the
# evidence that is meant to survive lives in sim/<experiment-slug>/.
sim/.work/

# Machine-local PDK override (sim/pdk.json is the committed default).
sim/pdk.local.json
