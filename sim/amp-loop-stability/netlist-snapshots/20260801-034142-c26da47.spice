XM5 tail tail_bias vss vss nfet_03v3 L=4u W=10u nf=1 ad='int((nf+1)/2) * W/nf * 0.18u' as='int((nf+2)/2) * W/nf * 0.18u' pd='2*int((nf+1)/2) * (W/nf + 0.18u)'
+ ps='2*int((nf+2)/2) * (W/nf + 0.18u)' nrd='0.18u / W' nrs='0.18u / W' sa=0 sb=0 sd=0 m=1
.ends

vsup vdd 0 dc {vdd_val}
Xcore vdd sns1 sns2 0 fb_gates vref ibias bandgap_core
Xamp sns2 sns1 0 amp_out vdd ibias bandgap_amp
vt fb_gates amp_out AC 1 0

.ic v(fb_gates)=1.0 v(amp_out)=1.0 v(sns1)=0.6 v(sns2)=0.6 v(vref)=1.2 v(ibias)=0.6
+ v(xcore.casc)=1.8
