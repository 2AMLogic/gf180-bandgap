      "unit": "V"
    },
    {
      "name": "vbe_a_4",
      "spice": ".meas dc vbe_a_4 FIND v(ea) AT=4",
      "unit": "V"
    },
    {
      "name": "vbe_m_4",
      "spice": ".meas dc vbe_m_4 FIND v(em) AT=4",
      "unit": "V"
    },
    {
      "name": "vbe_u_5p07",
      "spice": ".meas dc vbe_u_5p07 FIND v(eu) AT=5.07",
      "unit": "V"
    },
    {
      "name": "vbe_a_5p07",
      "spice": ".meas dc vbe_a_5p07 FIND v(ea) AT=5.07",
      "unit": "V"
    },
    {
      "name": "vbe_m_5p07",
      "spice": ".meas dc vbe_m_5p07 FIND v(em) AT=5.07",
      "unit": "V"
    },
    {
      "name": "vbe_u_6p5",
      "spice": ".meas dc vbe_u_6p5 FIND v(eu) AT=6.5",
      "unit": "V"
    },
    {
      "name": "vbe_a_6p5",
      "spice": ".meas dc vbe_a_6p5 FIND v(ea) AT=6.5",
      "unit": "V"
    },
    {
      "name": "vbe_m_6p5",
      "spice": ".meas dc vbe_m_6p5 FIND v(em) AT=6.5",
      "unit": "V"
    }
