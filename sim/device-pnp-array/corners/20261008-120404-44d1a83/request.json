{
  "netlist": "body.spice",
  "engine": "ngspice",
  "models": {
    "pdk": "gf180mcuD",
    "lib": "libs.tech/ngspice/sm141064.ngspice"
  },
  "corners": {
    "process": [
      {
        "name": "bjt_ss",
        "sections": [
          "bjt_ss"
        ]
      },
      {
        "name": "bjt_typical",
        "sections": [
          "bjt_typical"
        ]
      },
      {
        "name": "bjt_ff",
        "sections": [
          "bjt_ff"
        ]
      }
    ],
    "temperature_c": [
      -40.0,
      27.0,
      125.0
    ]
  },
  "analysis": {
    "kind": "dc",
    "args": "Vctrl 4.0 7.0 0.01"
