          "res_ss",
          "bjt_typical",
          "diode_typical",
          "moscap_typical",
          "mimcap_typical"
        ]
      },
      {
        "name": "bjt_ff",
        "sections": [
          "typical",
          "res_typical",
          "bjt_ff",
          "diode_typical",
          "moscap_typical",
          "mimcap_typical"
        ]
      },
      {
        "name": "bjt_ss",
        "sections": [
          "typical",
          "res_typical",
          "bjt_ss",
          "diode_typical",
          "moscap_typical",
          "mimcap_typical"
        ]
      }
    ],
    "temperature_c": [
      -40,
      27,
      125
    ],
    "supply_v": {
      "vsup": [
        2.97,
        3.3,
        3.63
      ]
    }
  },
  "analysis": {
    "kind": "ac",
    "args": "dec 20 0.1 10meg"
  },
  "measurements": [
    {
      "name": "vdb_1hz",
      "spice": ".meas ac vdb_1hz FIND vdb(vref) AT=1",
      "unit": "dB"
    },
    {
      "name": "vdb_10hz",
      "spice": ".meas ac vdb_10hz FIND vdb(vref) AT=10",
      "unit": "dB"
    },
    {
      "name": "vdb_100hz",
      "spice": ".meas ac vdb_100hz FIND vdb(vref) AT=100",
      "unit": "dB"
    },
    {
      "name": "vdb_1khz",
      "spice": ".meas ac vdb_1khz FIND vdb(vref) AT=1000",
      "unit": "dB"
    },
    {
      "name": "vdb_10khz",
      "spice": ".meas ac vdb_10khz FIND vdb(vref) AT=10000",
      "unit": "dB"
    },
    {
      "name": "vdb_100khz",
      "spice": ".meas ac vdb_100khz FIND vdb(vref) AT=100000",
      "unit": "dB"
    },
    {
      "name": "vdb_1mhz",
      "spice": ".meas ac vdb_1mhz FIND vdb(vref) AT=1e+06",
