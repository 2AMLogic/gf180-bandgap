v {xschem version=3.4.7 file_version=1.2
* bandgap_core symbol -- Brokaw-cell core + cascoded current-mode
* bias/output stage (issue #8)
* Pins: vdd, vss, fb, sns1, sns2, vref, ibias, casc
* "casc" added by issue #11 for the startup circuit -- see bandgap_core.sch.
}
G {}
K {type=subcircuit
format="@spiceprefix@name @pinlist bandgap_core"
template="name=x1
spiceprefix=X"
}
V {}
S {}
E {}
L 4 -40 -90 40 -90 {}
L 4 -40 90 40 90 {}
L 4 -40 -90 -40 90 {}
L 4 40 -90 40 90 {}
B 5 -42 62 -38 66 {name=vdd dir=inout pinnumber=1}
B 5 -42 18 -38 22 {name=sns1 dir=out pinnumber=2}
B 5 -42 -8 -38 -4 {name=sns2 dir=out pinnumber=3}
B 5 -42 -62 -38 -58 {name=vss dir=inout pinnumber=4}
B 5 38 62 42 66 {name=fb dir=in pinnumber=5}
B 5 38 18 42 22 {name=vref dir=out pinnumber=6}
B 5 38 -8 42 -4 {name=ibias dir=out pinnumber=7}
B 5 38 -32 42 -28 {name=casc dir=out pinnumber=8}
T {vdd} -35 64 0 1 0.2 0.2 {}
T {sns1} -35 20 0 1 0.2 0.2 {}
T {sns2} -35 -6 0 1 0.2 0.2 {}
T {vss} -35 -60 0 1 0.2 0.2 {}
T {fb} 35 64 0 0 0.2 0.2 {}
T {vref} 35 20 0 0 0.2 0.2 {}
T {ibias} 35 -6 0 0 0.2 0.2 {}
T {casc} 35 -30 0 0 0.2 0.2 {}
T {@name} -38 95 0 0 0.2 0.2 {}
T {bandgap_core} -25 0 0 0 0.2 0.2 {}
