{
  "name": "loom-workspace",
  "description": "Loom-managed workspace with AI development orchestration",
  "private": true,
  "scripts": {
    "worktree:return": "./.loom/scripts/worktree-return.sh",
    "check:ci": "bash .github/scripts/lint.sh && bash sim/selftest.sh",
    "check:all": "bash .github/scripts/lint.sh && bash sim/selftest.sh",
    "test": "bash sim/selftest.sh",
    "test:unit": "python3 -m unittest discover -s sim/tests -t sim/tests -v",
    "sim:env": "python3 sim/run_corners.py --check-env",
    "sim:list": "python3 sim/run_corners.py --list",
    "sim:smoke": "python3 sim/run_corners.py smoke-bias",
    "sim:suite": "python3 sim/run_suite.py",
    "sim:suite:list": "python3 sim/run_suite.py --list",
    "lint": "bash .github/scripts/lint.sh"
  }
}
